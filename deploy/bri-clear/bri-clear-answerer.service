[Unit]
Description=Diva clear-channel digital answerer (TTY profile)
Requires=divas4linux.service
After=divas4linux.service network.target
[Service]
ExecStartPre=/usr/bin/test -c /dev/ttyds5
ExecStart=/usr/bin/python3 /usr/local/sbin/bri_clear_answerer.py --config /etc/bri-clear/config.json
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
