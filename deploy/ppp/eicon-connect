#!/bin/sh
# Capture only the modem result line, before PPP owns the serial stream.
# Diva ttyds counterpart of modem-connect.
set -eu
device="$1"
case "$device" in
 ttyds3|ttyds4) number=7910;;
 ttyds1|ttyds2) number=7900;;
 ttyds12|ttyds13) number=7930;;
 ttyds14|ttyds15) number=7920;;
 *) exit 2;;
esac
umask 077
mkdir -p /run/ppp-modem
: > "/run/ppp-modem/$device.report"
exec /usr/sbin/chat -r "/run/ppp-modem/$device.report" -f "/etc/chatscripts/eicon-$number-answer"
