# Direct PPP over the MultiTech BRI modems, Cisco number 7910.
# First bundle link (ttyM4). Forms one MLPPP bundle with multitech-7910-b:
# both links share name, address pair and ifname so the second link joins
# the bundle instead of raising a second independent session.
/dev/ttyM4
115200
lock
modem
crtscts
nodetach
persist
maxfail 0
holdoff 3
require-pap
name multitech-7910
passive
nodefaultroute
noproxyarp
noipv6
noccp
novj
asyncmap 0
lcp-echo-interval 10
lcp-echo-failure 6
multilink
mrru 1500
10.254.104.1:10.254.104.2
ifname mtppp0
linkname multitech-7910
ipparam multitech-7910
connect "/usr/local/lib/ppp-web/modem-connect ttyM4"
