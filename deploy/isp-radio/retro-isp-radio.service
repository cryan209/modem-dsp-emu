[Unit]
Description=Retro ISP on-demand radio conversions
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/retro-isp-radio/radio.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=1G
TasksMax=128
CPUQuota=200%
Restart=on-failure
KillMode=control-group
[Install]
WantedBy=multi-user.target
