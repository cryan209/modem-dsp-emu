#!/bin/sh
# Capture only the modem result line, before PPP owns the serial stream.
set -eu
case "$1" in ttyM4|ttyM5) device="$1";; *) exit 2;; esac
umask 077
mkdir -p /run/ppp-modem
: > "/run/ppp-modem/$device.report"
exec /usr/sbin/chat -r "/run/ppp-modem/$device.report" -f /etc/chatscripts/multitech-answer
